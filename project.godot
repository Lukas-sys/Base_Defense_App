; Godot-Projektdatei. Am besten im Godot-Editor bearbeiten (Projekt > Projekteinstellungen).

config_version=5

[application]

config/name="Hofküche"
config/description="Ernten, backen, verkaufen, ausbauen."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/window_width_override=486
window/size/window_height_override=864
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
